/// Resolves each row's persisted source settings into one local effective Slot.
module BYOHapticsSourceBinding

in ToolRoot: Slot element

in Row0UseBodyNode: bool
in Row0SelectedBodyNode: Renderite.Shared.BodyNode mutable
in Row0ManualSource: Slot mutable
in Row0Target: string mutable
in Row0TargetAutoManaged: bool mutable
in Row0LastAutoTarget: string mutable
in Row0ClearButton: IButton global
in Row0SourceConfigured: bool mutable

in Row1UseBodyNode: bool
in Row1SelectedBodyNode: Renderite.Shared.BodyNode mutable
in Row1ManualSource: Slot mutable
in Row1Target: string mutable
in Row1TargetAutoManaged: bool mutable
in Row1LastAutoTarget: string mutable
in Row1ClearButton: IButton global
in Row1SourceConfigured: bool mutable

in Row2UseBodyNode: bool
in Row2SelectedBodyNode: Renderite.Shared.BodyNode mutable
in Row2ManualSource: Slot mutable
in Row2Target: string mutable
in Row2TargetAutoManaged: bool mutable
in Row2LastAutoTarget: string mutable
in Row2ClearButton: IButton global
in Row2SourceConfigured: bool mutable

in Row3UseBodyNode: bool
in Row3SelectedBodyNode: Renderite.Shared.BodyNode mutable
in Row3ManualSource: Slot mutable
in Row3Target: string mutable
in Row3TargetAutoManaged: bool mutable
in Row3LastAutoTarget: string mutable
in Row3ClearButton: IButton global
in Row3SourceConfigured: bool mutable

where {
    User = LocalUser;
    UserRoot = User->UserRootSlot;
    ToolIsUnderLocalUser = IsChildOf(
        Instance=ToolRoot,
        Other=UserRoot,
        IncludeSelf=true);

    Row0SuggestedTarget =
        if Row0SelectedBodyNode == BodyNode.LeftHand then "left"
        else if Row0SelectedBodyNode == BodyNode.LeftPalm then "left"
        else if Row0SelectedBodyNode == BodyNode.LeftController then "left"
        else if Row0SelectedBodyNode == BodyNode.RightHand then "right"
        else if Row0SelectedBodyNode == BodyNode.RightPalm then "right"
        else if Row0SelectedBodyNode == BodyNode.RightController then "right"
        else if Row0SelectedBodyNode == BodyNode.Head then "head"
        else if Row0SelectedBodyNode == BodyNode.View then "head"
        else if Row0SelectedBodyNode == BodyNode.Hips then "hips"
        else if Row0SelectedBodyNode == BodyNode.Chest then "chest"
        else if Row0SelectedBodyNode == BodyNode.UpperChest then "chest"
        else "";
    Row1SuggestedTarget =
        if Row1SelectedBodyNode == BodyNode.LeftHand then "left"
        else if Row1SelectedBodyNode == BodyNode.LeftPalm then "left"
        else if Row1SelectedBodyNode == BodyNode.LeftController then "left"
        else if Row1SelectedBodyNode == BodyNode.RightHand then "right"
        else if Row1SelectedBodyNode == BodyNode.RightPalm then "right"
        else if Row1SelectedBodyNode == BodyNode.RightController then "right"
        else if Row1SelectedBodyNode == BodyNode.Head then "head"
        else if Row1SelectedBodyNode == BodyNode.View then "head"
        else if Row1SelectedBodyNode == BodyNode.Hips then "hips"
        else if Row1SelectedBodyNode == BodyNode.Chest then "chest"
        else if Row1SelectedBodyNode == BodyNode.UpperChest then "chest"
        else "";
    Row2SuggestedTarget =
        if Row2SelectedBodyNode == BodyNode.LeftHand then "left"
        else if Row2SelectedBodyNode == BodyNode.LeftPalm then "left"
        else if Row2SelectedBodyNode == BodyNode.LeftController then "left"
        else if Row2SelectedBodyNode == BodyNode.RightHand then "right"
        else if Row2SelectedBodyNode == BodyNode.RightPalm then "right"
        else if Row2SelectedBodyNode == BodyNode.RightController then "right"
        else if Row2SelectedBodyNode == BodyNode.Head then "head"
        else if Row2SelectedBodyNode == BodyNode.View then "head"
        else if Row2SelectedBodyNode == BodyNode.Hips then "hips"
        else if Row2SelectedBodyNode == BodyNode.Chest then "chest"
        else if Row2SelectedBodyNode == BodyNode.UpperChest then "chest"
        else "";
    Row3SuggestedTarget =
        if Row3SelectedBodyNode == BodyNode.LeftHand then "left"
        else if Row3SelectedBodyNode == BodyNode.LeftPalm then "left"
        else if Row3SelectedBodyNode == BodyNode.LeftController then "left"
        else if Row3SelectedBodyNode == BodyNode.RightHand then "right"
        else if Row3SelectedBodyNode == BodyNode.RightPalm then "right"
        else if Row3SelectedBodyNode == BodyNode.RightController then "right"
        else if Row3SelectedBodyNode == BodyNode.Head then "head"
        else if Row3SelectedBodyNode == BodyNode.View then "head"
        else if Row3SelectedBodyNode == BodyNode.Hips then "hips"
        else if Row3SelectedBodyNode == BodyNode.Chest then "chest"
        else if Row3SelectedBodyNode == BodyNode.UpperChest then "chest"
        else "";

    switch ButtonEvents(Button=Row0ClearButton)
    | Pressed |> impulse {
        If(
            Condition=Row0UseBodyNode,
            OnTrue=impulse { Row0SelectedBodyNode <- BodyNode.NONE; },
            OnFalse=impulse { Row0ManualSource <- null<Slot>; });
    };

    switch ButtonEvents(Button=Row1ClearButton)
    | Pressed |> impulse {
        If(
            Condition=Row1UseBodyNode,
            OnTrue=impulse { Row1SelectedBodyNode <- BodyNode.NONE; },
            OnFalse=impulse { Row1ManualSource <- null<Slot>; });
    };

    switch ButtonEvents(Button=Row2ClearButton)
    | Pressed |> impulse {
        If(
            Condition=Row2UseBodyNode,
            OnTrue=impulse { Row2SelectedBodyNode <- BodyNode.NONE; },
            OnFalse=impulse { Row2ManualSource <- null<Slot>; });
    };

    switch ButtonEvents(Button=Row3ClearButton)
    | Pressed |> impulse {
        If(
            Condition=Row3UseBodyNode,
            OnTrue=impulse { Row3SelectedBodyNode <- BodyNode.NONE; },
            OnFalse=impulse { Row3ManualSource <- null<Slot>; });
    };

    SecondsTimer(
        Interval=0.25,
        UpdatingUser=User->asDrivenGlobal,
        SkipIfNull=true,
        OnUpdate=impulse {
        If(
            Condition=ToolIsUnderLocalUser,
            OnTrue=impulse {
        Row0SourceConfigured <- if Row0UseBodyNode then Row0SelectedBodyNode != BodyNode.NONE else NotNull(Instance=Row0ManualSource);
        Row1SourceConfigured <- if Row1UseBodyNode then Row1SelectedBodyNode != BodyNode.NONE else NotNull(Instance=Row1ManualSource);
        Row2SourceConfigured <- if Row2UseBodyNode then Row2SelectedBodyNode != BodyNode.NONE else NotNull(Instance=Row2ManualSource);
        Row3SourceConfigured <- if Row3UseBodyNode then Row3SelectedBodyNode != BodyNode.NONE else NotNull(Instance=Row3ManualSource);
        If(
            Condition=Row0UseBodyNode,
            OnTrue=impulse {
                If(
                    Condition=Row0TargetAutoManaged,
                    OnTrue=impulse {
                        If(
                            Condition=Row0Target == Row0LastAutoTarget,
                            OnTrue=impulse {
                                If(
                                    Condition=Row0SuggestedTarget != "",
                                    OnTrue=impulse {
                                        Row0Target <- Row0SuggestedTarget;
                                        Row0LastAutoTarget <- Row0SuggestedTarget;
                                    });
                            },
                            OnFalse=Row0TargetAutoManaged <- false);
                    },
                    OnFalse=impulse {
                        If(
                            Condition=Row0Target == "",
                            OnTrue=impulse {
                                If(
                                    Condition=Row0SuggestedTarget != "",
                                    OnTrue=impulse {
                                        Row0Target <- Row0SuggestedTarget;
                                        Row0LastAutoTarget <- Row0SuggestedTarget;
                                        Row0TargetAutoManaged <- true;
                                    });
                            });
                    });
            });
        If(
            Condition=Row1UseBodyNode,
            OnTrue=impulse {
                If(
                    Condition=Row1TargetAutoManaged,
                    OnTrue=impulse {
                        If(
                            Condition=Row1Target == Row1LastAutoTarget,
                            OnTrue=impulse {
                                If(
                                    Condition=Row1SuggestedTarget != "",
                                    OnTrue=impulse {
                                        Row1Target <- Row1SuggestedTarget;
                                        Row1LastAutoTarget <- Row1SuggestedTarget;
                                    });
                            },
                            OnFalse=Row1TargetAutoManaged <- false);
                    },
                    OnFalse=impulse {
                        If(
                            Condition=Row1Target == "",
                            OnTrue=impulse {
                                If(
                                    Condition=Row1SuggestedTarget != "",
                                    OnTrue=impulse {
                                        Row1Target <- Row1SuggestedTarget;
                                        Row1LastAutoTarget <- Row1SuggestedTarget;
                                        Row1TargetAutoManaged <- true;
                                    });
                            });
                    });
            });
        If(
            Condition=Row2UseBodyNode,
            OnTrue=impulse {
                If(
                    Condition=Row2TargetAutoManaged,
                    OnTrue=impulse {
                        If(
                            Condition=Row2Target == Row2LastAutoTarget,
                            OnTrue=impulse {
                                If(
                                    Condition=Row2SuggestedTarget != "",
                                    OnTrue=impulse {
                                        Row2Target <- Row2SuggestedTarget;
                                        Row2LastAutoTarget <- Row2SuggestedTarget;
                                    });
                            },
                            OnFalse=Row2TargetAutoManaged <- false);
                    },
                    OnFalse=impulse {
                        If(
                            Condition=Row2Target == "",
                            OnTrue=impulse {
                                If(
                                    Condition=Row2SuggestedTarget != "",
                                    OnTrue=impulse {
                                        Row2Target <- Row2SuggestedTarget;
                                        Row2LastAutoTarget <- Row2SuggestedTarget;
                                        Row2TargetAutoManaged <- true;
                                    });
                            });
                    });
            });
        If(
            Condition=Row3UseBodyNode,
            OnTrue=impulse {
                If(
                    Condition=Row3TargetAutoManaged,
                    OnTrue=impulse {
                        If(
                            Condition=Row3Target == Row3LastAutoTarget,
                            OnTrue=impulse {
                                If(
                                    Condition=Row3SuggestedTarget != "",
                                    OnTrue=impulse {
                                        Row3Target <- Row3SuggestedTarget;
                                        Row3LastAutoTarget <- Row3SuggestedTarget;
                                    });
                            },
                            OnFalse=Row3TargetAutoManaged <- false);
                    },
                    OnFalse=impulse {
                        If(
                            Condition=Row3Target == "",
                            OnTrue=impulse {
                                If(
                                    Condition=Row3SuggestedTarget != "",
                                    OnTrue=impulse {
                                        Row3Target <- Row3SuggestedTarget;
                                        Row3LastAutoTarget <- Row3SuggestedTarget;
                                        Row3TargetAutoManaged <- true;
                                    });
                            });
                    });
            });
        });
        });
}

