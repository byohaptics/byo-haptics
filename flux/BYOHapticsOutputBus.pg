/// Publishes transport-independent sensation values for each sampler row.
module BYOHapticsOutputBus

in Row0Force: float
in Row0Vibration: float
in Row0Pain: float
in Row0Temperature: float
in Row0Enabled: bool
in Row0SourceValid: bool
in Row0Target: string
in Row0Gain: float

in Row1Force: float
in Row1Vibration: float
in Row1Pain: float
in Row1Temperature: float
in Row1Enabled: bool
in Row1SourceValid: bool
in Row1Target: string
in Row1Gain: float

in Row2Force: float
in Row2Vibration: float
in Row2Pain: float
in Row2Temperature: float
in Row2Enabled: bool
in Row2SourceValid: bool
in Row2Target: string
in Row2Gain: float

in Row3Force: float
in Row3Vibration: float
in Row3Pain: float
in Row3Temperature: float
in Row3Enabled: bool
in Row3SourceValid: bool
in Row3Target: string
in Row3Gain: float

in GlobalGain: float
in MinimumPulseDuration: float
in OutputBusActive: bool
in OutputBusRow0Force: float mutable
in OutputBusRow0Vibration: float mutable
in OutputBusRow0Pain: float mutable
in OutputBusRow0Temperature: float mutable
in OutputBusRow1Force: float mutable
in OutputBusRow1Vibration: float mutable
in OutputBusRow1Pain: float mutable
in OutputBusRow1Temperature: float mutable
in OutputBusRow2Force: float mutable
in OutputBusRow2Vibration: float mutable
in OutputBusRow2Pain: float mutable
in OutputBusRow2Temperature: float mutable
in OutputBusRow3Force: float mutable
in OutputBusRow3Vibration: float mutable
in OutputBusRow3Pain: float mutable
in OutputBusRow3Temperature: float mutable
in Row0ForceHeld: float mutable
in Row0ForceHoldRemaining: float mutable
in Row0VibrationHeld: float mutable
in Row0VibrationHoldRemaining: float mutable
in Row0PainHeld: float mutable
in Row0PainHoldRemaining: float mutable
in Row0TemperatureHeld: float mutable
in Row0TemperatureHoldRemaining: float mutable
in Row1ForceHeld: float mutable
in Row1ForceHoldRemaining: float mutable
in Row1VibrationHeld: float mutable
in Row1VibrationHoldRemaining: float mutable
in Row1PainHeld: float mutable
in Row1PainHoldRemaining: float mutable
in Row1TemperatureHeld: float mutable
in Row1TemperatureHoldRemaining: float mutable
in Row2ForceHeld: float mutable
in Row2ForceHoldRemaining: float mutable
in Row2VibrationHeld: float mutable
in Row2VibrationHoldRemaining: float mutable
in Row2PainHeld: float mutable
in Row2PainHoldRemaining: float mutable
in Row2TemperatureHeld: float mutable
in Row2TemperatureHoldRemaining: float mutable
in Row3ForceHeld: float mutable
in Row3ForceHoldRemaining: float mutable
in Row3VibrationHeld: float mutable
in Row3VibrationHoldRemaining: float mutable
in Row3PainHeld: float mutable
in Row3PainHoldRemaining: float mutable
in Row3TemperatureHeld: float mutable
in Row3TemperatureHoldRemaining: float mutable

where {
    Row0Valid = if Row0Enabled then (if Row0SourceValid then not (Row0Target == "") else false) else false;
    Row1Valid = if Row1Enabled then (if Row1SourceValid then not (Row1Target == "") else false) else false;
    Row2Valid = if Row2Enabled then (if Row2SourceValid then not (Row2Target == "") else false) else false;
    Row3Valid = if Row3Enabled then (if Row3SourceValid then not (Row3Target == "") else false) else false;

    Row0Active = if OutputBusActive then Row0Valid else false;
    Row1Active = if OutputBusActive then Row1Valid else false;
    Row2Active = if OutputBusActive then Row2Valid else false;
    Row3Active = if OutputBusActive then Row3Valid else false;

    Row0ForceOut = if Row0Active then (Row0Force * Row0Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row0VibrationOut = if Row0Active then (Row0Vibration * Row0Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row0PainOut = if Row0Active then (Row0Pain * Row0Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row0TemperatureOut = if Row0Active then (Row0Temperature * Row0Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row1ForceOut = if Row1Active then (Row1Force * Row1Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row1VibrationOut = if Row1Active then (Row1Vibration * Row1Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row1PainOut = if Row1Active then (Row1Pain * Row1Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row1TemperatureOut = if Row1Active then (Row1Temperature * Row1Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row2ForceOut = if Row2Active then (Row2Force * Row2Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row2VibrationOut = if Row2Active then (Row2Vibration * Row2Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row2PainOut = if Row2Active then (Row2Pain * Row2Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row2TemperatureOut = if Row2Active then (Row2Temperature * Row2Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row3ForceOut = if Row3Active then (Row3Force * Row3Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row3VibrationOut = if Row3Active then (Row3Vibration * Row3Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row3PainOut = if Row3Active then (Row3Pain * Row3Gain * GlobalGain)->Clamp01_Float else 0.0;
    Row3TemperatureOut = if Row3Active then (Row3Temperature * Row3Gain * GlobalGain)->Clamp01_Float else 0.0;

    HoldWindow = if MinimumPulseDuration > 0.0 then MinimumPulseDuration + 0.01 else 0.0;
    User = LocalUser;

    SecondsTimer(
        Interval=0.01,
        UpdatingUser=User->asDrivenGlobal,
        SkipIfNull=true,
        OnUpdate=impulse {
        Row0ForceHoldRemaining <- if Row0ForceHoldRemaining > 0.01 then Row0ForceHoldRemaining - 0.01 else 0.0;
        Row0VibrationHoldRemaining <- if Row0VibrationHoldRemaining > 0.01 then Row0VibrationHoldRemaining - 0.01 else 0.0;
        Row0PainHoldRemaining <- if Row0PainHoldRemaining > 0.01 then Row0PainHoldRemaining - 0.01 else 0.0;
        Row0TemperatureHoldRemaining <- if Row0TemperatureHoldRemaining > 0.01 then Row0TemperatureHoldRemaining - 0.01 else 0.0;
        Row1ForceHoldRemaining <- if Row1ForceHoldRemaining > 0.01 then Row1ForceHoldRemaining - 0.01 else 0.0;
        Row1VibrationHoldRemaining <- if Row1VibrationHoldRemaining > 0.01 then Row1VibrationHoldRemaining - 0.01 else 0.0;
        Row1PainHoldRemaining <- if Row1PainHoldRemaining > 0.01 then Row1PainHoldRemaining - 0.01 else 0.0;
        Row1TemperatureHoldRemaining <- if Row1TemperatureHoldRemaining > 0.01 then Row1TemperatureHoldRemaining - 0.01 else 0.0;
        Row2ForceHoldRemaining <- if Row2ForceHoldRemaining > 0.01 then Row2ForceHoldRemaining - 0.01 else 0.0;
        Row2VibrationHoldRemaining <- if Row2VibrationHoldRemaining > 0.01 then Row2VibrationHoldRemaining - 0.01 else 0.0;
        Row2PainHoldRemaining <- if Row2PainHoldRemaining > 0.01 then Row2PainHoldRemaining - 0.01 else 0.0;
        Row2TemperatureHoldRemaining <- if Row2TemperatureHoldRemaining > 0.01 then Row2TemperatureHoldRemaining - 0.01 else 0.0;
        Row3ForceHoldRemaining <- if Row3ForceHoldRemaining > 0.01 then Row3ForceHoldRemaining - 0.01 else 0.0;
        Row3VibrationHoldRemaining <- if Row3VibrationHoldRemaining > 0.01 then Row3VibrationHoldRemaining - 0.01 else 0.0;
        Row3PainHoldRemaining <- if Row3PainHoldRemaining > 0.01 then Row3PainHoldRemaining - 0.01 else 0.0;
        Row3TemperatureHoldRemaining <- if Row3TemperatureHoldRemaining > 0.01 then Row3TemperatureHoldRemaining - 0.01 else 0.0;
        });

    switch LocalUpdate
    | OnUpdate |> impulse {
        If(Condition=not Row0Active, OnTrue=impulse { Row0ForceHoldRemaining <- 0.0; Row0VibrationHoldRemaining <- 0.0; Row0PainHoldRemaining <- 0.0; Row0TemperatureHoldRemaining <- 0.0; });
        If(Condition=not Row1Active, OnTrue=impulse { Row1ForceHoldRemaining <- 0.0; Row1VibrationHoldRemaining <- 0.0; Row1PainHoldRemaining <- 0.0; Row1TemperatureHoldRemaining <- 0.0; });
        If(Condition=not Row2Active, OnTrue=impulse { Row2ForceHoldRemaining <- 0.0; Row2VibrationHoldRemaining <- 0.0; Row2PainHoldRemaining <- 0.0; Row2TemperatureHoldRemaining <- 0.0; });
        If(Condition=not Row3Active, OnTrue=impulse { Row3ForceHoldRemaining <- 0.0; Row3VibrationHoldRemaining <- 0.0; Row3PainHoldRemaining <- 0.0; Row3TemperatureHoldRemaining <- 0.0; });

        If(Condition=Row0ForceOut > 0.0, OnTrue=impulse { Row0ForceHeld <- Row0ForceOut; Row0ForceHoldRemaining <- HoldWindow; });
        If(Condition=Row0VibrationOut > 0.0, OnTrue=impulse { Row0VibrationHeld <- Row0VibrationOut; Row0VibrationHoldRemaining <- HoldWindow; });
        If(Condition=Row0PainOut > 0.0, OnTrue=impulse { Row0PainHeld <- Row0PainOut; Row0PainHoldRemaining <- HoldWindow; });
        If(Condition=Row0TemperatureOut > 0.0, OnTrue=impulse { Row0TemperatureHeld <- Row0TemperatureOut; Row0TemperatureHoldRemaining <- HoldWindow; });
        If(Condition=Row1ForceOut > 0.0, OnTrue=impulse { Row1ForceHeld <- Row1ForceOut; Row1ForceHoldRemaining <- HoldWindow; });
        If(Condition=Row1VibrationOut > 0.0, OnTrue=impulse { Row1VibrationHeld <- Row1VibrationOut; Row1VibrationHoldRemaining <- HoldWindow; });
        If(Condition=Row1PainOut > 0.0, OnTrue=impulse { Row1PainHeld <- Row1PainOut; Row1PainHoldRemaining <- HoldWindow; });
        If(Condition=Row1TemperatureOut > 0.0, OnTrue=impulse { Row1TemperatureHeld <- Row1TemperatureOut; Row1TemperatureHoldRemaining <- HoldWindow; });
        If(Condition=Row2ForceOut > 0.0, OnTrue=impulse { Row2ForceHeld <- Row2ForceOut; Row2ForceHoldRemaining <- HoldWindow; });
        If(Condition=Row2VibrationOut > 0.0, OnTrue=impulse { Row2VibrationHeld <- Row2VibrationOut; Row2VibrationHoldRemaining <- HoldWindow; });
        If(Condition=Row2PainOut > 0.0, OnTrue=impulse { Row2PainHeld <- Row2PainOut; Row2PainHoldRemaining <- HoldWindow; });
        If(Condition=Row2TemperatureOut > 0.0, OnTrue=impulse { Row2TemperatureHeld <- Row2TemperatureOut; Row2TemperatureHoldRemaining <- HoldWindow; });
        If(Condition=Row3ForceOut > 0.0, OnTrue=impulse { Row3ForceHeld <- Row3ForceOut; Row3ForceHoldRemaining <- HoldWindow; });
        If(Condition=Row3VibrationOut > 0.0, OnTrue=impulse { Row3VibrationHeld <- Row3VibrationOut; Row3VibrationHoldRemaining <- HoldWindow; });
        If(Condition=Row3PainOut > 0.0, OnTrue=impulse { Row3PainHeld <- Row3PainOut; Row3PainHoldRemaining <- HoldWindow; });
        If(Condition=Row3TemperatureOut > 0.0, OnTrue=impulse { Row3TemperatureHeld <- Row3TemperatureOut; Row3TemperatureHoldRemaining <- HoldWindow; });

        OutputBusRow0Force <- if Row0Active then (if Row0ForceOut > 0.0 then Row0ForceOut else (if Row0ForceHoldRemaining > 0.0 then Row0ForceHeld else 0.0)) else 0.0;
        OutputBusRow0Vibration <- if Row0Active then (if Row0VibrationOut > 0.0 then Row0VibrationOut else (if Row0VibrationHoldRemaining > 0.0 then Row0VibrationHeld else 0.0)) else 0.0;
        OutputBusRow0Pain <- if Row0Active then (if Row0PainOut > 0.0 then Row0PainOut else (if Row0PainHoldRemaining > 0.0 then Row0PainHeld else 0.0)) else 0.0;
        OutputBusRow0Temperature <- if Row0Active then (if Row0TemperatureOut > 0.0 then Row0TemperatureOut else (if Row0TemperatureHoldRemaining > 0.0 then Row0TemperatureHeld else 0.0)) else 0.0;
        OutputBusRow1Force <- if Row1Active then (if Row1ForceOut > 0.0 then Row1ForceOut else (if Row1ForceHoldRemaining > 0.0 then Row1ForceHeld else 0.0)) else 0.0;
        OutputBusRow1Vibration <- if Row1Active then (if Row1VibrationOut > 0.0 then Row1VibrationOut else (if Row1VibrationHoldRemaining > 0.0 then Row1VibrationHeld else 0.0)) else 0.0;
        OutputBusRow1Pain <- if Row1Active then (if Row1PainOut > 0.0 then Row1PainOut else (if Row1PainHoldRemaining > 0.0 then Row1PainHeld else 0.0)) else 0.0;
        OutputBusRow1Temperature <- if Row1Active then (if Row1TemperatureOut > 0.0 then Row1TemperatureOut else (if Row1TemperatureHoldRemaining > 0.0 then Row1TemperatureHeld else 0.0)) else 0.0;
        OutputBusRow2Force <- if Row2Active then (if Row2ForceOut > 0.0 then Row2ForceOut else (if Row2ForceHoldRemaining > 0.0 then Row2ForceHeld else 0.0)) else 0.0;
        OutputBusRow2Vibration <- if Row2Active then (if Row2VibrationOut > 0.0 then Row2VibrationOut else (if Row2VibrationHoldRemaining > 0.0 then Row2VibrationHeld else 0.0)) else 0.0;
        OutputBusRow2Pain <- if Row2Active then (if Row2PainOut > 0.0 then Row2PainOut else (if Row2PainHoldRemaining > 0.0 then Row2PainHeld else 0.0)) else 0.0;
        OutputBusRow2Temperature <- if Row2Active then (if Row2TemperatureOut > 0.0 then Row2TemperatureOut else (if Row2TemperatureHoldRemaining > 0.0 then Row2TemperatureHeld else 0.0)) else 0.0;
        OutputBusRow3Force <- if Row3Active then (if Row3ForceOut > 0.0 then Row3ForceOut else (if Row3ForceHoldRemaining > 0.0 then Row3ForceHeld else 0.0)) else 0.0;
        OutputBusRow3Vibration <- if Row3Active then (if Row3VibrationOut > 0.0 then Row3VibrationOut else (if Row3VibrationHoldRemaining > 0.0 then Row3VibrationHeld else 0.0)) else 0.0;
        OutputBusRow3Pain <- if Row3Active then (if Row3PainOut > 0.0 then Row3PainOut else (if Row3PainHoldRemaining > 0.0 then Row3PainHeld else 0.0)) else 0.0;
        OutputBusRow3Temperature <- if Row3Active then (if Row3TemperatureOut > 0.0 then Row3TemperatureOut else (if Row3TemperatureHoldRemaining > 0.0 then Row3TemperatureHeld else 0.0)) else 0.0;
    };
}

