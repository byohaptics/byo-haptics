/// Publishes transport-independent sensation values for each sampler row.
module BYOHapticsOutputBus

in Row0Force: float
in Row0Vibration: float
in Row0Pain: float
in Row0Temperature: float
in Row0Enabled: bool
in Row0SourceValid: bool
in Row0Target: string
in Row0Gain: float

in Row1Force: float
in Row1Vibration: float
in Row1Pain: float
in Row1Temperature: float
in Row1Enabled: bool
in Row1SourceValid: bool
in Row1Target: string
in Row1Gain: float

in Row2Force: float
in Row2Vibration: float
in Row2Pain: float
in Row2Temperature: float
in Row2Enabled: bool
in Row2SourceValid: bool
in Row2Target: string
in Row2Gain: float

in Row3Force: float
in Row3Vibration: float
in Row3Pain: float
in Row3Temperature: float
in Row3Enabled: bool
in Row3SourceValid: bool
in Row3Target: string
in Row3Gain: float

in GlobalGain: float
in MinimumPulseDuration: float
in OutputBusActive: bool
in OutputBusRow0Force: float mutable
in OutputBusRow0Vibration: float mutable
in OutputBusRow0Pain: float mutable
in OutputBusRow0Temperature: float mutable
in OutputBusRow1Force: float mutable
in OutputBusRow1Vibration: float mutable
in OutputBusRow1Pain: float mutable
in OutputBusRow1Temperature: float mutable
in OutputBusRow2Force: float mutable
in OutputBusRow2Vibration: float mutable
in OutputBusRow2Pain: float mutable
in OutputBusRow2Temperature: float mutable
in OutputBusRow3Force: float mutable
in OutputBusRow3Vibration: float mutable
in OutputBusRow3Pain: float mutable
in OutputBusRow3Temperature: float mutable
in Row0HoldRemaining: float4 mutable
in Row1HoldRemaining: float4 mutable
in Row2HoldRemaining: float4 mutable
in Row3HoldRemaining: float4 mutable

where {
    Row0Valid = if Row0Enabled then (if Row0SourceValid then not (Row0Target == "") else false) else false;
    Row1Valid = if Row1Enabled then (if Row1SourceValid then not (Row1Target == "") else false) else false;
    Row2Valid = if Row2Enabled then (if Row2SourceValid then not (Row2Target == "") else false) else false;
    Row3Valid = if Row3Enabled then (if Row3SourceValid then not (Row3Target == "") else false) else false;

    Row0Active = if OutputBusActive then Row0Valid else false;
    Row1Active = if OutputBusActive then Row1Valid else false;
    Row2Active = if OutputBusActive then Row2Valid else false;
    Row3Active = if OutputBusActive then Row3Valid else false;

    ZeroSensation = pack(0.0, 0.0, 0.0, 0.0);
    Row0Sensation = if Row0Active then (pack(Row0Force, Row0Vibration, Row0Pain, Row0Temperature) * (Row0Gain * GlobalGain))->Clamp01_Float4 else ZeroSensation;
    Row1Sensation = if Row1Active then (pack(Row1Force, Row1Vibration, Row1Pain, Row1Temperature) * (Row1Gain * GlobalGain))->Clamp01_Float4 else ZeroSensation;
    Row2Sensation = if Row2Active then (pack(Row2Force, Row2Vibration, Row2Pain, Row2Temperature) * (Row2Gain * GlobalGain))->Clamp01_Float4 else ZeroSensation;
    Row3Sensation = if Row3Active then (pack(Row3Force, Row3Vibration, Row3Pain, Row3Temperature) * (Row3Gain * GlobalGain))->Clamp01_Float4 else ZeroSensation;
    Row0ForceOut, Row0VibrationOut, Row0PainOut, Row0TemperatureOut = Row0Sensation->unpack;
    Row1ForceOut, Row1VibrationOut, Row1PainOut, Row1TemperatureOut = Row1Sensation->unpack;
    Row2ForceOut, Row2VibrationOut, Row2PainOut, Row2TemperatureOut = Row2Sensation->unpack;
    Row3ForceOut, Row3VibrationOut, Row3PainOut, Row3TemperatureOut = Row3Sensation->unpack;
    Row0ForceHold, Row0VibrationHold, Row0PainHold, Row0TemperatureHold = Row0HoldRemaining->unpack;
    Row1ForceHold, Row1VibrationHold, Row1PainHold, Row1TemperatureHold = Row1HoldRemaining->unpack;
    Row2ForceHold, Row2VibrationHold, Row2PainHold, Row2TemperatureHold = Row2HoldRemaining->unpack;
    Row3ForceHold, Row3VibrationHold, Row3PainHold, Row3TemperatureHold = Row3HoldRemaining->unpack;
    HoldWindow = if MinimumPulseDuration > 0.0 then MinimumPulseDuration else 0.0;
    FrameTime = DeltaTime;

    Row0NextHold = if Row0Active then pack(
        if Row0ForceOut > 0.0 then HoldWindow else (if Row0ForceHold > FrameTime then Row0ForceHold - FrameTime else 0.0),
        if Row0VibrationOut > 0.0 then HoldWindow else (if Row0VibrationHold > FrameTime then Row0VibrationHold - FrameTime else 0.0),
        if Row0PainOut > 0.0 then HoldWindow else (if Row0PainHold > FrameTime then Row0PainHold - FrameTime else 0.0),
        if Row0TemperatureOut > 0.0 then HoldWindow else (if Row0TemperatureHold > FrameTime then Row0TemperatureHold - FrameTime else 0.0)) else ZeroSensation;
    Row1NextHold = if Row1Active then pack(
        if Row1ForceOut > 0.0 then HoldWindow else (if Row1ForceHold > FrameTime then Row1ForceHold - FrameTime else 0.0),
        if Row1VibrationOut > 0.0 then HoldWindow else (if Row1VibrationHold > FrameTime then Row1VibrationHold - FrameTime else 0.0),
        if Row1PainOut > 0.0 then HoldWindow else (if Row1PainHold > FrameTime then Row1PainHold - FrameTime else 0.0),
        if Row1TemperatureOut > 0.0 then HoldWindow else (if Row1TemperatureHold > FrameTime then Row1TemperatureHold - FrameTime else 0.0)) else ZeroSensation;
    Row2NextHold = if Row2Active then pack(
        if Row2ForceOut > 0.0 then HoldWindow else (if Row2ForceHold > FrameTime then Row2ForceHold - FrameTime else 0.0),
        if Row2VibrationOut > 0.0 then HoldWindow else (if Row2VibrationHold > FrameTime then Row2VibrationHold - FrameTime else 0.0),
        if Row2PainOut > 0.0 then HoldWindow else (if Row2PainHold > FrameTime then Row2PainHold - FrameTime else 0.0),
        if Row2TemperatureOut > 0.0 then HoldWindow else (if Row2TemperatureHold > FrameTime then Row2TemperatureHold - FrameTime else 0.0)) else ZeroSensation;
    Row3NextHold = if Row3Active then pack(
        if Row3ForceOut > 0.0 then HoldWindow else (if Row3ForceHold > FrameTime then Row3ForceHold - FrameTime else 0.0),
        if Row3VibrationOut > 0.0 then HoldWindow else (if Row3VibrationHold > FrameTime then Row3VibrationHold - FrameTime else 0.0),
        if Row3PainOut > 0.0 then HoldWindow else (if Row3PainHold > FrameTime then Row3PainHold - FrameTime else 0.0),
        if Row3TemperatureOut > 0.0 then HoldWindow else (if Row3TemperatureHold > FrameTime then Row3TemperatureHold - FrameTime else 0.0)) else ZeroSensation;

    switch LocalUpdate
    | OnUpdate |> impulse {
        Row0HoldRemaining <- Row0NextHold;
        Row1HoldRemaining <- Row1NextHold;
        Row2HoldRemaining <- Row2NextHold;
        Row3HoldRemaining <- Row3NextHold;

        OutputBusRow0Force <- if Row0Active then (if Row0ForceOut > 0.0 then Row0ForceOut else (if Row0ForceHold > 0.0 then OutputBusRow0Force else 0.0)) else 0.0;
        OutputBusRow0Vibration <- if Row0Active then (if Row0VibrationOut > 0.0 then Row0VibrationOut else (if Row0VibrationHold > 0.0 then OutputBusRow0Vibration else 0.0)) else 0.0;
        OutputBusRow0Pain <- if Row0Active then (if Row0PainOut > 0.0 then Row0PainOut else (if Row0PainHold > 0.0 then OutputBusRow0Pain else 0.0)) else 0.0;
        OutputBusRow0Temperature <- if Row0Active then (if Row0TemperatureOut > 0.0 then Row0TemperatureOut else (if Row0TemperatureHold > 0.0 then OutputBusRow0Temperature else 0.0)) else 0.0;
        OutputBusRow1Force <- if Row1Active then (if Row1ForceOut > 0.0 then Row1ForceOut else (if Row1ForceHold > 0.0 then OutputBusRow1Force else 0.0)) else 0.0;
        OutputBusRow1Vibration <- if Row1Active then (if Row1VibrationOut > 0.0 then Row1VibrationOut else (if Row1VibrationHold > 0.0 then OutputBusRow1Vibration else 0.0)) else 0.0;
        OutputBusRow1Pain <- if Row1Active then (if Row1PainOut > 0.0 then Row1PainOut else (if Row1PainHold > 0.0 then OutputBusRow1Pain else 0.0)) else 0.0;
        OutputBusRow1Temperature <- if Row1Active then (if Row1TemperatureOut > 0.0 then Row1TemperatureOut else (if Row1TemperatureHold > 0.0 then OutputBusRow1Temperature else 0.0)) else 0.0;
        OutputBusRow2Force <- if Row2Active then (if Row2ForceOut > 0.0 then Row2ForceOut else (if Row2ForceHold > 0.0 then OutputBusRow2Force else 0.0)) else 0.0;
        OutputBusRow2Vibration <- if Row2Active then (if Row2VibrationOut > 0.0 then Row2VibrationOut else (if Row2VibrationHold > 0.0 then OutputBusRow2Vibration else 0.0)) else 0.0;
        OutputBusRow2Pain <- if Row2Active then (if Row2PainOut > 0.0 then Row2PainOut else (if Row2PainHold > 0.0 then OutputBusRow2Pain else 0.0)) else 0.0;
        OutputBusRow2Temperature <- if Row2Active then (if Row2TemperatureOut > 0.0 then Row2TemperatureOut else (if Row2TemperatureHold > 0.0 then OutputBusRow2Temperature else 0.0)) else 0.0;
        OutputBusRow3Force <- if Row3Active then (if Row3ForceOut > 0.0 then Row3ForceOut else (if Row3ForceHold > 0.0 then OutputBusRow3Force else 0.0)) else 0.0;
        OutputBusRow3Vibration <- if Row3Active then (if Row3VibrationOut > 0.0 then Row3VibrationOut else (if Row3VibrationHold > 0.0 then OutputBusRow3Vibration else 0.0)) else 0.0;
        OutputBusRow3Pain <- if Row3Active then (if Row3PainOut > 0.0 then Row3PainOut else (if Row3PainHold > 0.0 then OutputBusRow3Pain else 0.0)) else 0.0;
        OutputBusRow3Temperature <- if Row3Active then (if Row3TemperatureOut > 0.0 then Row3TemperatureOut else (if Row3TemperatureHold > 0.0 then OutputBusRow3Temperature else 0.0)) else 0.0;
    };
}

