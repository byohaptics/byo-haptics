    BusPluginId = ~input<string>("BYOHaptics.Output.v1/SelectedPluginId");
    BusRow0Force = ~input<float>("BYOHaptics.Output.v1/Row0Force");
    BusRow0Vibration = ~input<float>("BYOHaptics.Output.v1/Row0Vibration");
    BusRow0Pain = ~input<float>("BYOHaptics.Output.v1/Row0Pain");
    BusRow0Temperature = ~input<float>("BYOHaptics.Output.v1/Row0Temperature");
    BusRow1Force = ~input<float>("BYOHaptics.Output.v1/Row1Force");
    BusRow1Vibration = ~input<float>("BYOHaptics.Output.v1/Row1Vibration");
