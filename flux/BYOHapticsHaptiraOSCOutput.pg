    Channel14Row2 = if Row2Target == "14" then Row2Intensity else 0.0;
    Channel14Row3 = if Row3Target == "14" then Row3Intensity else 0.0;
    Channel14Rows01 = ValueMax(A=Channel14Row0, B=Channel14Row1);
    Channel14Rows23 = ValueMax(A=Channel14Row2, B=Channel14Row3);
    Channel14Output = ValueMax(A=Channel14Rows01, B=Channel14Rows23);
    Channel14DelayedOutput = DelayValue(DelaySeconds=0.05, Value=Channel14Output).DelayedValue;
    Channel14SentValue = if Channel14Output > 0.0 then Channel14Output else (if Channel14DelayedOutput > 0.0 then 0.0000000000001 else 0.0);
    Channel15BasePath = ConcatenateString(A=ConfigChannelPrefix, B="15");
    Channel15PathValue = ConcatenateString(A=Channel15BasePath, B=ConfigChannelSuffix);
    Channel15Row0 = if Row0Target == "15" then Row0Intensity else 0.0;
    Channel15Row1 = if Row1Target == "15" then Row1Intensity else 0.0;
    Channel15Row2 = if Row2Target == "15" then Row2Intensity else 0.0;
    Channel15Row3 = if Row3Target == "15" then Row3Intensity else 0.0;
    Channel15Rows01 = ValueMax(A=Channel15Row0, B=Channel15Row1);
    Channel15Rows23 = ValueMax(A=Channel15Row2, B=Channel15Row3);
    Channel15Output = ValueMax(A=Channel15Rows01, B=Channel15Rows23);
    Channel15DelayedOutput = DelayValue(DelaySeconds=0.05, Value=Channel15Output).DelayedValue;
    Channel15SentValue = if Channel15Output > 0.0 then Channel15Output else (if Channel15DelayedOutput > 0.0 then 0.0000000000001 else 0.0);
    AnyChannelOutput1 = ValueMax(A=Channel00Output, B=Channel01Output);
    AnyChannelOutput2 = ValueMax(A=AnyChannelOutput1, B=Channel02Output);
    AnyChannelOutput3 = ValueMax(A=AnyChannelOutput2, B=Channel03Output);
    AnyChannelOutput4 = ValueMax(A=AnyChannelOutput3, B=Channel04Output);
    AnyChannelOutput5 = ValueMax(A=AnyChannelOutput4, B=Channel05Output);
    AnyChannelOutput6 = ValueMax(A=AnyChannelOutput5, B=Channel06Output);
    AnyChannelOutput7 = ValueMax(A=AnyChannelOutput6, B=Channel07Output);
    AnyChannelOutput8 = ValueMax(A=AnyChannelOutput7, B=Channel08Output);
    AnyChannelOutput9 = ValueMax(A=AnyChannelOutput8, B=Channel09Output);
    AnyChannelOutput10 = ValueMax(A=AnyChannelOutput9, B=Channel10Output);
    AnyChannelOutput11 = ValueMax(A=AnyChannelOutput10, B=Channel11Output);
    AnyChannelOutput12 = ValueMax(A=AnyChannelOutput11, B=Channel12Output);
    AnyChannelOutput13 = ValueMax(A=AnyChannelOutput12, B=Channel13Output);
    AnyChannelOutput14 = ValueMax(A=AnyChannelOutput13, B=Channel14Output);
    AnyChannelOutput15 = ValueMax(A=AnyChannelOutput14, B=Channel15Output);
    AnyChannelOutput = AnyChannelOutput15;
    DelayedAnyChannelOutput = DelayValue(DelaySeconds=0.25, Value=AnyChannelOutput).DelayedValue;
    ResendTailActive = if AnyChannelOutput > 0.0 then true else DelayedAnyChannelOutput > 0.0;
    InactiveResendInterval = 1000000000.0;
    ActiveResendInterval = if ResendTailActive then 0.05 else InactiveResendInterval;

    OnLoaded(Trigger=impulse {
        ConfigConfigured <- ConfigurationValid;
        If(Condition=ConfigurationValid, OnTrue=impulse { ConfigEndpoint <- EndpointCandidate; SenderURL <- EndpointCandidate; });
        Channel00Path <- Channel00PathValue; Channel01Path <- Channel01PathValue; Channel02Path <- Channel02PathValue; Channel03Path <- Channel03PathValue; Channel04Path <- Channel04PathValue; Channel05Path <- Channel05PathValue; Channel06Path <- Channel06PathValue; Channel07Path <- Channel07PathValue; Channel08Path <- Channel08PathValue; Channel09Path <- Channel09PathValue; Channel10Path <- Channel10PathValue; Channel11Path <- Channel11PathValue; Channel12Path <- Channel12PathValue; Channel13Path <- Channel13PathValue; Channel14Path <- Channel14PathValue; Channel15Path <- Channel15PathValue;
        Channel00Value <- 0.0; Channel01Value <- 0.0; Channel02Value <- 0.0; Channel03Value <- 0.0; Channel04Value <- 0.0; Channel05Value <- 0.0; Channel06Value <- 0.0; Channel07Value <- 0.0; Channel08Value <- 0.0; Channel09Value <- 0.0; Channel10Value <- 0.0; Channel11Value <- 0.0; Channel12Value <- 0.0; Channel13Value <- 0.0; Channel14Value <- 0.0; Channel15Value <- 0.0;
        SenderAutoResendInterval <- InactiveResendInterval;
        SenderIsSending <- ActiveState;
        If(Condition=ActiveState, OnTrue=HandlingUser <- User);
    });

    FireOnValueChange(
        Value=ActiveState,
        OnlyForUser=User,
        OnChanged=If(
            Condition=ActiveState,
            OnTrue=impulse {
                HandlingUser <- User;
                ConfigEndpoint <- EndpointCandidate;
                SenderURL <- EndpointCandidate;
                SenderIsSending <- true;
            },
            OnFalse=impulse {
                Channel00Value <- 0.0; Channel01Value <- 0.0; Channel02Value <- 0.0; Channel03Value <- 0.0; Channel04Value <- 0.0; Channel05Value <- 0.0; Channel06Value <- 0.0; Channel07Value <- 0.0; Channel08Value <- 0.0; Channel09Value <- 0.0; Channel10Value <- 0.0; Channel11Value <- 0.0; Channel12Value <- 0.0; Channel13Value <- 0.0; Channel14Value <- 0.0; Channel15Value <- 0.0;
                SenderAutoResendInterval <- InactiveResendInterval;
                SenderIsSending <- false;
                WriteDynamicValueVariable(
                    Target=PluginRoot,
                    Path="BYOHaptics.Output.v1/Connected",
                    Value=false);
            }));

    switch LocalUpdate
    | OnUpdate |> impulse {
        ConfigConfigured <- ConfigurationValid;
        If(Condition=ConfigurationValid, OnTrue=impulse { ConfigEndpoint <- EndpointCandidate; SenderURL <- EndpointCandidate; });
        Channel00Path <- Channel00PathValue; Channel01Path <- Channel01PathValue; Channel02Path <- Channel02PathValue; Channel03Path <- Channel03PathValue; Channel04Path <- Channel04PathValue; Channel05Path <- Channel05PathValue; Channel06Path <- Channel06PathValue; Channel07Path <- Channel07PathValue; Channel08Path <- Channel08PathValue; Channel09Path <- Channel09PathValue; Channel10Path <- Channel10PathValue; Channel11Path <- Channel11PathValue; Channel12Path <- Channel12PathValue; Channel13Path <- Channel13PathValue; Channel14Path <- Channel14PathValue; Channel15Path <- Channel15PathValue;
        DiagnosticsActive <- ActiveState;
        DiagnosticsConnected <- false;
        PackageInstalled <- PackageInstalledState;
        PackageVisualActive <- not PackageInstalledState;
        PackageGrabbableEnabled <- not PackageInstalledState;
        If(
            Condition=ActiveState,
            OnTrue=impulse {
                HandlingUser <- User;
                Channel00Value <- Channel00SentValue; Channel01Value <- Channel01SentValue; Channel02Value <- Channel02SentValue; Channel03Value <- Channel03SentValue; Channel04Value <- Channel04SentValue; Channel05Value <- Channel05SentValue; Channel06Value <- Channel06SentValue; Channel07Value <- Channel07SentValue; Channel08Value <- Channel08SentValue; Channel09Value <- Channel09SentValue; Channel10Value <- Channel10SentValue; Channel11Value <- Channel11SentValue; Channel12Value <- Channel12SentValue; Channel13Value <- Channel13SentValue; Channel14Value <- Channel14SentValue; Channel15Value <- Channel15SentValue;
                SenderAutoResendInterval <- ActiveResendInterval;
                SenderIsSending <- true;
            },
            OnFalse=impulse {
                Channel00Value <- 0.0; Channel01Value <- 0.0; Channel02Value <- 0.0; Channel03Value <- 0.0; Channel04Value <- 0.0; Channel05Value <- 0.0; Channel06Value <- 0.0; Channel07Value <- 0.0; Channel08Value <- 0.0; Channel09Value <- 0.0; Channel10Value <- 0.0; Channel11Value <- 0.0; Channel12Value <- 0.0; Channel13Value <- 0.0; Channel14Value <- 0.0; Channel15Value <- 0.0;
                SenderAutoResendInterval <- InactiveResendInterval;
                SenderIsSending <- false;
            });
    };

    UpdatesTimer(
        Interval=1,
        UpdatingUser=User->asDrivenGlobal,
        SkipIfNull=true,
        OnUpdate=impulse {
            WriteDynamicValueVariable(
                Target=PluginRoot,
                Path="BYOHaptics.Output.v1/ConnectionStatusAvailable",
                Value=CanReportConnection);
            If(
                Condition=ActiveState,
                OnTrue=WriteDynamicValueVariable(
                    Target=PluginRoot,
                    Path="BYOHaptics.Output.v1/Connected",
                    Value=false));
        });
}

