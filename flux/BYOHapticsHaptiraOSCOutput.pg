    Channel12SentValue = if Channel12Output > 0.0 then Channel12Output else (if Channel12DelayedOutput > 0.0 then 0.0000000000001 else 0.0);
    Channel13BasePath = ConcatenateString(A=ConfigChannelPrefix, B="13");
    Channel13PathValue = ConcatenateString(A=Channel13BasePath, B=ConfigChannelSuffix);
    Channel13Row0 = if Row0Target == "13" then Row0Intensity else 0.0;
    Channel13Row1 = if Row1Target == "13" then Row1Intensity else 0.0;
    Channel13Row2 = if Row2Target == "13" then Row2Intensity else 0.0;
