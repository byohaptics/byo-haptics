    BusRow3Pain = ~input<float>("BYOHaptics.Output.v1/Row3Pain");
    BusRow3Temperature = ~input<float>("BYOHaptics.Output.v1/Row3Temperature");
    BusTarget0 = ~input<string>("BYOHaptics.Output.v1/Target0");
    BusTarget1 = ~input<string>("BYOHaptics.Output.v1/Target1");
    BusTarget2 = ~input<string>("BYOHaptics.Output.v1/Target2");
    BusTarget3 = ~input<string>("BYOHaptics.Output.v1/Target3");

    EndpointScheme = ConcatenateString(A="osc://", B=ConfigDeviceAddress);
    EndpointHost = ConcatenateString(A=EndpointScheme, B=":");
    EndpointPort = ToString_Int(V=ConfigDevicePort);
    EndpointText = ConcatenateString(A=EndpointHost, B=EndpointPort);
    EndpointCandidate = uri(EndpointText);
    EscapedDeviceAddress = EscapeUriDataString(String=ConfigDeviceAddress);
    AddressPresent = StringLength(A=ConfigDeviceAddress) > 0;
    AddressValid = if AddressPresent then EscapedDeviceAddress == ConfigDeviceAddress else false;
    PortValid = if ConfigDevicePort > 0 then ConfigDevicePort < 65536 else false;
    ConfigurationValid = if AddressValid then (if PortValid then not IsNull(Instance=EndpointCandidate) else false) else false;

    PluginParent = GetParentSlot(Instance=PluginRoot);
    PackageInstalledState = GetSlotName(Instance=PluginParent) == "PluginSocket";
    Selected = BusPluginId.Value == ThisPluginId;
    BusSelectionActive =
        if BusContractVersion.HasValue then
            (if BusContractVersion.Value == 1 then
                (if BusActive.HasValue then
                    (if BusPluginId.HasValue then (if BusActive.Value then Selected else false) else false)
                else false)
            else false)
        else false;
    ActiveState = if BusSelectionActive then ConfigurationValid else false;

    Row0FV = ValueMax(A=BusRow0Force.Value, B=BusRow0Vibration.Value);
    Row0PT = ValueMax(A=BusRow0Pain.Value, B=BusRow0Temperature.Value);
    Row0Intensity = ValueMax(A=Row0FV, B=Row0PT)->Clamp01_Float;
    Row0Target = if BusTarget0.HasValue then BusTarget0.Value else "";
    Row1FV = ValueMax(A=BusRow1Force.Value, B=BusRow1Vibration.Value);
    Row1PT = ValueMax(A=BusRow1Pain.Value, B=BusRow1Temperature.Value);
    Row1Intensity = ValueMax(A=Row1FV, B=Row1PT)->Clamp01_Float;
    Row1Target = if BusTarget1.HasValue then BusTarget1.Value else "";
    Row2FV = ValueMax(A=BusRow2Force.Value, B=BusRow2Vibration.Value);
    Row2PT = ValueMax(A=BusRow2Pain.Value, B=BusRow2Temperature.Value);
    Row2Intensity = ValueMax(A=Row2FV, B=Row2PT)->Clamp01_Float;
    Row2Target = if BusTarget2.HasValue then BusTarget2.Value else "";
    Row3FV = ValueMax(A=BusRow3Force.Value, B=BusRow3Vibration.Value);
    Row3PT = ValueMax(A=BusRow3Pain.Value, B=BusRow3Temperature.Value);
    Row3Intensity = ValueMax(A=Row3FV, B=Row3PT)->Clamp01_Float;
    Row3Target = if BusTarget3.HasValue then BusTarget3.Value else "";

    Channel00BasePath = ConcatenateString(A=ConfigChannelPrefix, B="00");
    Channel00PathValue = ConcatenateString(A=Channel00BasePath, B=ConfigChannelSuffix);
    Channel00Row0 = if Row0Target == "00" then Row0Intensity else 0.0;
    Channel00Row1 = if Row1Target == "00" then Row1Intensity else 0.0;
    Channel00Row2 = if Row2Target == "00" then Row2Intensity else 0.0;
    Channel00Row3 = if Row3Target == "00" then Row3Intensity else 0.0;
