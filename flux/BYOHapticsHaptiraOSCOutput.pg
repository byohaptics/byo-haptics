    Channel11SentValue = if Channel11Output > 0.0 then Channel11Output else (if Channel11DelayedOutput > 0.0 then 0.0000000000001 else 0.0);
    Channel12BasePath = ConcatenateString(A=ConfigChannelPrefix, B="12");
    Channel12PathValue = ConcatenateString(A=Channel12BasePath, B=ConfigChannelSuffix);
    Channel12Row0 = if Row0Target == "12" then Row0Intensity else 0.0;
    Channel12Row1 = if Row1Target == "12" then Row1Intensity else 0.0;
    Channel12Row2 = if Row2Target == "12" then Row2Intensity else 0.0;
