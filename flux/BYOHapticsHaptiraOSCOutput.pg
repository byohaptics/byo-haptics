in ConfigDevicePort: int
in ConfigEndpoint: Uri mutable
in ConfigConfigured: bool mutable
in ConfigChannelPrefix: string
in ConfigChannelSuffix: string
in HandlingUser: User mutable
in SenderURL: Uri mutable
in SenderIsSending: bool mutable
in SenderAutoResendInterval: float mutable
in Channel00Path: string mutable
