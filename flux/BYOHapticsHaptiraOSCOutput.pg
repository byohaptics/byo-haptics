    Channel00Output = ValueMax(A=Channel00Rows01, B=Channel00Rows23);
    Channel00DelayedOutput = DelayValue(DelaySeconds=0.05, Value=Channel00Output).DelayedValue;
    Channel00SentValue = if Channel00Output > 0.0 then Channel00Output else (if Channel00DelayedOutput > 0.0 then 0.0000000000001 else 0.0);
    Channel01BasePath = ConcatenateString(A=ConfigChannelPrefix, B="01");
