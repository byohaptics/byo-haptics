    Channel10Output = ValueMax(A=Channel10Rows01, B=Channel10Rows23);
    Channel10DelayedOutput = DelayValue(DelaySeconds=0.05, Value=Channel10Output).DelayedValue;
    Channel10SentValue = if Channel10Output > 0.0 then Channel10Output else (if Channel10DelayedOutput > 0.0 then 0.0000000000001 else 0.0);
    Channel11BasePath = ConcatenateString(A=ConfigChannelPrefix, B="11");
    Channel11PathValue = ConcatenateString(A=Channel11BasePath, B=ConfigChannelSuffix);
    Channel11Row0 = if Row0Target == "11" then Row0Intensity else 0.0;
